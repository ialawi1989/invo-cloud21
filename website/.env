# Local storefront dev config (read by src/server.ts via dotenv).
#
# `subDomain` is the key one: server.ts serves it from /assets/config.json,
# and TenantService reads that in step 2 — BEFORE its `window`/host checks —
# so the tenant resolves identically on SSR and in the browser. Mirrors
# oldEco's Config.subDomain. (environment.devTenant is only a browser-side
# fallback and never runs during SSR, which is why the slug came back empty
# and every /v1/ecommerce//… call 404'd.)
#
# Set this to your dev merchant slug.
subDomain=shussain
domain=local

# Backend the SSR server proxies / fetches OG meta from. Keep in sync with
# the client apiBase (host:3001) so server-side and browser agree.
BASE_URL=http://10.2.2.89:3001/v1
