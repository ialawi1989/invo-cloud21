# ── Backend API ────────────────────────────────────────────────────────
# Base URL the SSR Express layer talks to. Used as
#   `${BASE_URL}/ecommerce/${slug}/...` for tenant calls and as the
# target for the /v1 + /server/assets + /server/images proxies.
BASE_URL=http://localhost:3001/v1
websocketIP=http://localhost:3001/v1

# ── Tenant overrides ──────────────────────────────────────────────────
# When set, `subDomain` overrides host-based slug resolution. Useful
# for local dev when you're hitting `localhost:4000` but want the
# server to act as if it's a specific merchant.
domain=local
subDomain=

# ── Customizer iframe ─────────────────────────────────────────────────
# Origin of the dashboard that embeds '/' as a preview iframe. When
# set, the server emits `frame-ancestors 'self' <origin>` instead of
# the open `frame-ancestors *`.
DASHBOARD_ORIGIN=http://localhost:4700

# ── Logger ────────────────────────────────────────────────────────────
# Leave LOGGER_PROJECT_KEY empty to disable outbound log shipping.
LOGGER_ENDPOINT=https://your-domain.com
LOGGER_PROJECT_KEY=

# ── Server ────────────────────────────────────────────────────────────
PORT=4000
