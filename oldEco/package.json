    "serve:ssr:InvoEcommerceFront": "node dist/invo-ecommerce-front/server/server.mjs",
    "prebuild:ssr": "node scripts/bump-version.mjs",
    "build:ssr": "ng build InvoEcommerceFront --configuration=production",
    "serve:ssr": "node dist/invo-ecommerce-front/server/server.mjs"
  },
  "private": true,
  "dependencies": {
